{
  "config": {
    "default": true,
    // long lines are fine in prose and tables
    "MD013": false,
    // each step in docs/IMPLEMENTATION.md has its own "Tests" section
    "MD024": { "siblings_only": true },
    // inline HTML is used for badges
    "MD033": false,
    // the first line of a doc is not always an H1
    "MD041": false,
    // compact |---|---| tables
    "MD060": false
  },
  "globs": ["**/*.md"],
  // fixtures are test note trees, some deliberately broken
  "ignores": ["target/**", "fixtures/**"]
}
